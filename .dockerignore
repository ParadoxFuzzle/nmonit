# The Dockerfiles build from the project root. Keep the context small by
# excluding build artifacts, secrets, and files no image needs.

# Build artifacts
bin/
target/

# Development scripts
scripts/

# Deployment certs (large binary files, mounted at runtime instead)
deploy/certs/

# Secrets
.env
.env.*

# Build tools
Makefile

# Documentation
README.md
ARCHITECTURE.md
docs/
CONTRIBUTING.md
CHANGELOG.md

# Git
.git/
.gitignore

# Editor / IDE
.vscode/
.idea/
*.swp
*~
