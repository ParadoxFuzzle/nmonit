# Copy to .env before using docker-compose.prod.yml and replace every value.
# .env is gitignored. Generate random values with:
#   openssl rand -hex 32
NMONIT_API_KEY=replace-with-a-random-api-key
NMONIT_AGENT_TOKEN=replace-with-a-random-agent-token

# Grafana admin credentials for the production overlay.
GRAFANA_ADMIN_USER=replace-with-an-admin-username
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password
